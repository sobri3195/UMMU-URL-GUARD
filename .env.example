# Vite reads .env automatically. This is a server-only development proxy target.
# Do not use a VITE_ prefix here: the browser always requests same-origin /api.
API_PROXY_TARGET=http://127.0.0.1:8000

# Python reads process environment variables, not Vite's .env loader.
# Same-origin proxy/deployment needs no CORS. For separate origins, export:
# export ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only explicit HTTP(S) origins; no wildcard, URL path, or credentials.
ALLOWED_ORIGINS=
